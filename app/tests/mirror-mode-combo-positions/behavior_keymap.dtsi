#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mirror.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>

/*
 * Fork: mirror mode's combo-positions (PATCH_MIRROR_MODE.md §3.3).
 *
 *  pos  0  1  2  3     A B C D
 *       4  5  6  7     E F G H
 *       8  9 10 11     mirror TOG, J K L
 *
 * mirror-positions reflects rows 0 and 1 (0<->3, 1<->2, 4<->7, 5<->6); row 2 maps to itself.
 * combo-positions is different: row 0 keeps its keys (an opener/closer pair stays in order),
 * row 1 reflects, and 9/10 act as 2/3 (an arbitrary relocation).
 * Combos: {0,1} -> Y, {2,3} -> X, {4,5} -> Z.
 */
&kscan {
    rows = <3>;
    columns = <4>;
};

/ {
    behaviors {
        mirror: mirror {
            compatible = "zmk,behavior-mirror";
            #binding-cells = <1>;
            mirror-positions = <3 2 1 0  7 6 5 4  8 9 10 11>;
            combo-positions = <0 1 2 3  7 6 5 4  8 2 3 11>;
            base {
                layers = <0>;
            };
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_ab {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp Y>;
        };
        combo_cd {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&kp X>;
        };
        combo_ef {
            timeout-ms = <50>;
            key-positions = <4 5>;
            bindings = <&kp Z>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp A              &kp B  &kp C  &kp D
                &kp E              &kp F  &kp G  &kp H
                &mirror MIRROR_TOG &kp J  &kp K  &kp L>;
        };
    };
};
