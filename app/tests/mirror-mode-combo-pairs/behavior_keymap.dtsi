#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mirror.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>

/*
 * Fork: mirror mode `combo-pairs` (PATCH_MIRROR_MODE.md §3.4).
 *
 *  pos  0  1  2  3     A B C D            map: rows 0-1 reflected (0<->3, 1<->2, 4<->7, 5<->6)
 *       4  5  6  7     E F G H                 row 2 maps to itself
 *       8  9 10 11     mirror TOG, &mo 1 (layer 1 not listed in the mirror)
 *
 * Combos: {0,1} -> [ (opener), {1,2} -> ] (closer), paired; {0,1,2} -> Z, not paired. While
 * mirrored, the right-hand twins of [ give ], and the other way round.
 */
&kscan {
    rows = <3>;
    columns = <4>;
};

/ {
    behaviors {
        mirror: mirror {
            compatible = "zmk,behavior-mirror";
            #binding-cells = <1>;
            mirror-positions = <3 2 1 0  7 6 5 4  8 9 10 11>;
            base {
                layers = <0>;
                combo-pairs = <0 1 MIRROR_WITH 1 2>;
            };
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_open {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp LBKT>;
        };
        combo_close {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp RBKT>;
        };
        combo_three {
            timeout-ms = <50>;
            key-positions = <0 1 2>;
            bindings = <&kp Z>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp A              &kp B  &kp C  &kp D
                &kp E              &kp F  &kp G  &kp H
                &mirror MIRROR_TOG &mo 1  &none  &none>;
        };

        layer_1 {
            bindings = <
                &trans &trans &trans &trans
                &trans &trans &trans &trans
                &trans &trans &trans &trans>;
        };
    };
};
