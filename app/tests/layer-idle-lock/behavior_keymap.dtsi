#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>

/*
 * Layer 1 is held by &mo at (0,1). Inside layer 1 that same position is &tog 1, which is
 * the intended way out of a locked layer. (1,1) is &tog 1 on the base layer and &to 0
 * inside layer 1. enter/exit are &kp F13 / F14 so the lock edges show in the key log.
 */
/ {
    layer_idle_lock {
        compatible = "zmk,layer-idle-lock";

        lock_1 {
            layer = <1>;
            idle-ms = <500>;
            enter = <&kp F13>;
            exit = <&kp F14>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp B  &mo 1
                &kp C  &tog 1>;
        };

        layer_1 {
            bindings = <
                &kp N1  &tog 1
                &kp N2  &to 0>;
        };
    };
};
