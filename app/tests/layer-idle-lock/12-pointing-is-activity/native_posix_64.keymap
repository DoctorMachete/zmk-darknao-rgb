#include <behaviors.dtsi>
#include <behaviors/mouse_move.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * Pointer motion counts as activity. &mmv at (0,0) is pressed BEFORE &mo arms, so the key
 * itself is baseline (not "busy"); only the input events it generates can hold the lock off.
 */
/ {
    layer_idle_lock {
        compatible = "zmk,layer-idle-lock";

        lock_1 {
            layer = <1>;
            idle-ms = <500>;
            enter = <&kp F13>;
            exit = <&kp F14>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &mmv MOVE_RIGHT  &mo 1
                &kp C            &none>;
        };

        layer_1 {
            bindings = <
                &trans  &tog 1
                &kp N2  &none>;
        };
    };
};

&kscan {
    events = <
        /* cursor moving, then &mo held 1000 ms: no lock while it moves */
        ZMK_MOCK_PRESS(0,0,10)
        ZMK_MOCK_PRESS(0,1,1000)
        /* motion stops: the lock follows ~500 ms later */
        ZMK_MOCK_RELEASE(0,0,700)
        ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_PRESS(1,0,10)
        ZMK_MOCK_RELEASE(1,0,10)
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,10)
    >;
};
