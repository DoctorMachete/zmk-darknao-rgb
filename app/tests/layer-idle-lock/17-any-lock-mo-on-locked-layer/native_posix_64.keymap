#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>

/* (0,1) is transparent inside layer 1, so &mo 1 can be pressed on the locked layer. */
/ {
    layer_idle_lock {
        compatible = "zmk,layer-idle-lock";

        lock_1 {
            layer = <1>;
            idle-ms = <500>;
            enter = <&kp F13>;
            exit = <&kp F14>;
            triggers-on-any-lock;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp B  &mo 1
                &kp C  &tog 1>;
        };

        layer_1 {
            bindings = <
                &kp N1  &trans
                &tog 1  &to 0>;
        };
    };
};

&kscan {
    events = <
        /* &tog 1 from the base layer: locked, F13 */
        ZMK_MOCK_PRESS(1,1,10)
        ZMK_MOCK_RELEASE(1,1,10)
        /* &mo 1 held past idle-ms on the locked layer: not armed, no second F13 */
        ZMK_MOCK_PRESS(0,1,800)
        /* its release cannot turn off the locked layer */
        ZMK_MOCK_RELEASE(0,1,10)
        ZMK_MOCK_PRESS(0,0,10)
        ZMK_MOCK_RELEASE(0,0,10)
        /* &tog 1 inside layer 1: off, one F14 */
        ZMK_MOCK_PRESS(1,0,10)
        ZMK_MOCK_RELEASE(1,0,10)
        ZMK_MOCK_PRESS(0,0,10)
        ZMK_MOCK_RELEASE(0,0,10)
    >;
};
