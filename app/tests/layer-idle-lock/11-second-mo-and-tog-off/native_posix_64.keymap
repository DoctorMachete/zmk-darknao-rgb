#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>

/*
 * A second &mo 1 at (1,0) (transparent inside layer 1), and a toggle-mode "off"
 * instance at (1,1) inside layer 1.
 */
/ {
    behaviors {
        tog_off: tog_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };
    };

    layer_idle_lock {
        compatible = "zmk,layer-idle-lock";

        lock_1 {
            layer = <1>;
            idle-ms = <500>;
            enter = <&kp F13>;
            exit = <&kp F14>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp B  &mo 1
                &mo 1  &none>;
        };

        layer_1 {
            bindings = <
                &kp N1  &none
                &trans  &tog_off 1>;
        };
    };
};

&kscan {
    events = <
        /* lock via the first &mo */
        ZMK_MOCK_PRESS(0,1,600)
        ZMK_MOCK_RELEASE(0,1,10)
        /* the other &mo 1, pressed and released while locked: still locked */
        ZMK_MOCK_PRESS(1,0,10)
        ZMK_MOCK_RELEASE(1,0,1000)
        /* still layer 1: N1, and no second F13 */
        ZMK_MOCK_PRESS(0,0,10)
        ZMK_MOCK_RELEASE(0,0,10)
        /* toggle-mode "off" unlocks: off + F14 */
        ZMK_MOCK_PRESS(1,1,10)
        ZMK_MOCK_RELEASE(1,1,10)
        ZMK_MOCK_PRESS(0,0,10)
        ZMK_MOCK_RELEASE(0,0,10)
    >;
};
