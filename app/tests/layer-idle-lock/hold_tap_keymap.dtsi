#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>

/*
 * The GO60 shape: the layer key is a balanced hold-tap whose hold is &mo
 * (HTUI_mo_kp_bal_250_200_50 in go60.keymap), and inside the layer the same position
 * is &tog for the way out.
 */
/ {
    behaviors {
        ht_mo: ht_mo {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    layer_idle_lock {
        compatible = "zmk,layer-idle-lock";

        lock_1 {
            layer = <1>;
            idle-ms = <500>;
            enter = <&kp F13>;
            exit = <&kp F14>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp B  &ht_mo 1 DEL
                &kp C  &none>;
        };

        layer_1 {
            bindings = <
                &kp N1  &tog 1
                &kp N2  &none>;
        };
    };
};
