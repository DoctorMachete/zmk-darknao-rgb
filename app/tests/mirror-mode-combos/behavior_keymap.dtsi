#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mirror.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/kscan_mock.h>

/*
 * Fork: mirror mode with combos and hold-tap (PATCH_MIRROR_MODE.md).
 *
 *  pos  0  1  2  3     A B C D
 *       4  5  6  7     E F G &mt LSHFT H
 *       8  9 10 11     mirror TOG, none...
 *
 * Map reflects rows 0 and 1 (0<->3, 1<->2, 4<->7, 5<->6); row 2 maps to itself.
 * Combos: {2,3} -> X, {1,2,3} -> Y.
 */
&kscan {
    rows = <3>;
    columns = <4>;
};

/ {
    behaviors {
        mirror: mirror {
            compatible = "zmk,behavior-mirror";
            #binding-cells = <1>;
            mirror-positions = <3 2 1 0  7 6 5 4  8 9 10 11>;
            base {
                layers = <0>;
            };
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_cd {
            timeout-ms = <50>;
            key-positions = <2 3>;
            bindings = <&kp X>;
        };
        combo_bcd {
            timeout-ms = <50>;
            key-positions = <1 2 3>;
            bindings = <&kp Y>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp A              &kp B  &kp C  &kp D
                &kp E              &kp F  &kp G  &mt LSHFT H
                &mirror MIRROR_TOG &none  &none  &none>;
        };
    };
};
